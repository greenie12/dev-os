# ─── Supabase (public — safe to expose to the browser) ──────────────────────
# Copy from: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Copy from: Supabase Dashboard → Project Settings → API → anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Supabase (private — app/api/* route handlers only — SERVER ONLY) ────────
# Copy from: Supabase Dashboard → Project Settings → API → service_role key
# This is NOT the same value as the anon key above — copy the "service_role" row.
# NEVER expose this to the browser or commit a real value to git.
# Used only by lib/supabase/admin.ts (retention cron route) — bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ─── OpenAI (private — app/api/* route handlers only — SERVER ONLY) ──────────
# Get from: https://platform.openai.com/api-keys
# Used for: GPT-4o extraction (temp 0.1, JSON mode) and chat (temp 0.4)
OPENAI_API_KEY=

# ─── Cron auth (private — SERVER ONLY) ────────────────────────────────────────
# Random secret string (e.g. `openssl rand -hex 32`). Shared between this app
# and the Supabase pg_cron job (see database.sql §7) so app/api/cron/cleanup-storage
# can verify the request came from the scheduled job and not the public internet.
# NOT the same value as SUPABASE_SERVICE_ROLE_KEY.
CRON_SECRET=


# ─── App config ──────────────────────────────────────────────────────────────
# Base URL used for internal redirects (email confirmation links, etc.)
# In development: http://localhost:3000
# In production: your Vercel deployment URL (e.g. https://contractiq.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Max past chat messages fetched from the DB per turn, before lib/openai/chat.ts
# slices further down to 10-20 turns depending on query classification. Optional —
# defaults to 100 if unset. See lib/security/tokenLimiter.ts.
MAX_CHAT_HISTORY=100
